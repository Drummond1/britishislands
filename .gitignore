# --- OS / editor noise ------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.iml

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
.env.local
.env.*
!.env.local.example
*.egg-info/

# --- Logs / runtime ---------------------------------------------------------
logs/
*.log
nohup.out

# --- Local credentials ------------------------------------------------------
*.key
*.pem
.env*
!.env.local.example
config.local.*
**/secrets/

# --- Generated / cache data we DO NOT want in version control ---------------
# Re-fetchable from upstream APIs in minutes; would bloat the repo.
data/cache_*.json
data/cache_*.geojson
data/water_raw.json
data/water_raw_v2.json
data/coastline_raw.json
data/osm_raw.json
data/osm_ferries_raw.json
data/candidates_*.json
data/*.holdback
data/land_polygons.pickle
data/mainland_polygons.pickle

# Backup snapshots taken before destructive operations - regeneratable from
# the live JSONs + report logs. Keeping them out of git keeps the repo small
# and avoids confusing readers about which file is canonical.
data/islands.json.before-*
data/islands.json.corrupt-*
data/islands.json.tmp

# --- GTFS bundles -----------------------------------------------------------
# Multi-MB zip blobs from Traveline Scotland / BODS. Re-downloadable.
data/gtfs/
*.gtfs.zip

# --- MLX LoRA fine-tuning (local adapter weights) ---------------------------
adapters/

# CI-generated thin island HTML stubs (see scripts/generate_seo_artifacts.py)
profiles/
# Nation + name-slug landings (canonical SEO URLs)
islands/

# Nation shards for deferred frontend load (see scripts/build_islands_index.py)
data/shards/

# --- Tooling --------------------------------------------------------------
# Cursor-specific runtime artefacts (terminals, agent transcripts).
.cursor/projects/

# CI-staged GitHub Pages output (see scripts/prepare_pages_artifact.py)
_site/
