# Copy to .env.local (gitignored). Never commit real keys.
# Supabase: Project Settings → API

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
# Service role bypasses RLS — scripts / moderation only; never ship to the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Optional: Homedata live-listings (verify Terms allow static redistribution first)
# HOMEDATA_API_KEY=your_homedata_key
# HOMEDATA_API_BASE=https://api.homedata.co.uk/v1
